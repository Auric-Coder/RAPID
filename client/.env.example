# Google Maps JavaScript API — used by the dashboard's RapidMap component.
# Get these from the Google Cloud Console (APIs & Services > Credentials,
# and Google Maps Platform > Map Management for the Map ID).
VITE_GOOGLE_MAPS_MAP_ID=
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a separate Map ID styled for dark mode in the Cloud Console.
# Falls back to VITE_GOOGLE_MAPS_MAP_ID when unset.
VITE_GOOGLE_MAPS_DARK_MAP_ID=
