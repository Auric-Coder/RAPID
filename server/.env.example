# RAPID Server � Environment Variables
# Copy this to .env and fill in your values

# JWT secret for signing session cookies (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Supabase project credentials (Settings -> API in Supabase dashboard)
# Use the BASE project URL � NOT the /rest/v1/ URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_service_role_key_here

# Server port (default: 5000)
PORT=5000

# CORS origins for production (comma-separated, no trailing slashes)
# Example: CORS_ORIGINS=https://myapp.onrender.com,https://www.myapp.com
# Leave unset for local dev (localhost:3000 and localhost:5173 are allowed by default)
# CORS_ORIGINS=

# Azure OpenAI (Azure AI Foundry) — powers the citizen intake agent
# (server/src/agents/citizenIntakeAgent.js). Optional: if any of these
# are unset, the app automatically falls back to the deterministic
# keyword-based classifier (server/src/services/voiceAI/nlpClassifier.js)
# with zero loss of functionality — nothing else needs to change.
#
# ENDPOINT: the resource endpoint from Azure AI Foundry's "Overview" /
# "Endpoints" page — with or without the trailing /openai/v1, either
# works (aiConfig.js normalizes it). No API-version env var is needed;
# this targets the unified v1 API, which doesn't use one.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_DEPLOYMENT=your_chat_model_deployment_name
